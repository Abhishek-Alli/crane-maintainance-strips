# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=crane_maintenance
DB_USER=postgres
DB_PASSWORD=your_password

# Server Configuration
PORT=5001
NODE_ENV=development

# Google Sheets Configuration (V3 - Multi-Sheet Architecture)
GOOGLE_SHEETS_CREDENTIALS_PATH=./config/google-credentials.json
GOOGLE_SHEETS_SPREADSHEET_ID=your_spreadsheet_id_here
GOOGLE_SHEETS_WORKBOOK_NAME=Crane-Maintenance

# JWT Configuration (REQUIRED in production — use a long random string)
JWT_SECRET=your-secret-key-change-in-production-use-long-random-string
JWT_EXPIRES_IN=24h

# CORS Configuration (exact frontend origin)
CORS_ORIGIN=http://localhost:3000

# Cron HTTP endpoints (REQUIRED to enable /api/cron/*)
CRON_SECRET=change-me-to-a-long-random-string
# Set true only for local testing without Authorization header
CRON_ALLOW_DEV=false

# Optional: enable GET /api/config/test-google-sheets for admins
ALLOW_SHEETS_TEST=false
